# Stage 1: Build
FROM node:22-alpine as build-stage
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

ARG BRISE_FRONTEND_EVENT_SERVICE_HOST
ENV VITE_EVENT_SERVICE_HOST=${BRISE_FRONTEND_EVENT_SERVICE_HOST}
ARG BRISE_FRONTEND_EVENT_SERVICE_PORT
ENV VITE_EVENT_SERVICE_PORT=${BRISE_FRONTEND_EVENT_SERVICE_PORT}
ARG BRISE_FRONTEND_SEARCHSPACE_EDITOR_HOST
ENV VITE_SEARCHSPACE_EDITOR_HOST=${BRISE_FRONTEND_SEARCHSPACE_EDITOR_HOST}
ARG BRISE_FRONTEND_SEARCHSPACE_EDITOR_PORT
ENV VITE_SEARCHSPACE_EDITOR_PORT=${BRISE_FRONTEND_SEARCHSPACE_EDITOR_PORT}
ARG BRISE_FRONTEND_WAFFLE_HOST
ENV VITE_WAFFLE_HOST=${BRISE_FRONTEND_WAFFLE_HOST}
ARG BRISE_FRONTEND_WAFFLE_PORT
ENV VITE_WAFFLE_PORT=${BRISE_FRONTEND_WAFFLE_PORT}

RUN npm run build
# Vite output in /app/dist

# Stage 2: Serve with Nginx
FROM nginx:1.30-alpine
COPY --from=build-stage /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80