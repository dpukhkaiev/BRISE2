    "Plot_0": {
      "PlotType": {
        "ConvergencePlot": {
          "Type": "convergence_plot",
          "enableGrouping": true,
          "title": "Tour Length Convergence by HH-PC Variant",
          "filterConditions": [
            { "path": "hhpc_variant", "pattern": "S-TPE|S-BRR|FRAMAB-H-TPE|FRAMAB-H-BRR|BRR-H-TPE|BRR-H-BRR" }
          ],
          "CustomGrouping": {
            "ValueGroupSpec": {
              "path": "hhpc_variant",
              "ValueGroupEntry_0": { "value": "S-TPE",        "displayName": "S-TPE" },
              "ValueGroupEntry_1": { "value": "S-BRR",        "displayName": "S-BRR" },
              "ValueGroupEntry_2": { "value": "FRAMAB-H-TPE", "displayName": "FRAMAB-H-TPE" },
              "ValueGroupEntry_3": { "value": "FRAMAB-H-BRR", "displayName": "FRAMAB-H-BRR" },
              "ValueGroupEntry_4": { "value": "BRR-H-TPE",    "displayName": "BRR-H-TPE" },
              "ValueGroupEntry_5": { "value": "BRR-H-BRR",    "displayName": "BRR-H-BRR" }
            }
          },
          "MetricAxis": {
            "metricDescription": "iterations completed",
            "label": "Iteration",
            "scale": "linear"
          },
          "ObjectiveAxis": {
            "objectivesToPlot": ["objective"],
            "normalize": false,
            "NormalizationStrategy": { "MinOverAll": { "Type": "min_over_all_experiments" } },
            "label": "Objective (tour length)",
            "scale": "linear"
          }
        }
