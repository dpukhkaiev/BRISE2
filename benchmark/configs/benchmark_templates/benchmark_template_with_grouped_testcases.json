{
    "Benchmark": {
        "Report": {
            "outputDirectory": "./results/reports/"
        },
        "Experiment": {
            "name": "grouped test cases",
            "description": "local testing of benchmark features",
            "objectivesToMeasure": [
                "Y1",
                "Y2",
                "Y3",
                "Y4",
                "Y5"
            ]
        },
        "Table": {
            "task": true,
            "model": true,
            "sampler": true,
            "configurationStrategy": true,
            "stopCondition": true,
            "experiment": true,
            "objective": true,
            "iterations": true,
            "initialValue": true,
            "finalBestValue": true,
            "improvementPercentage": true,
            "improvementAbsolute": true,
            "runtime": true
        },
        "Plot_0": {
            "PlotType": {
                "ConvergencePlot": {
                    "Type": "convergence_plot",
                    "enableGrouping": false,
                    "MetricAxis": {
                        "metricDescription": "iterations completed",
                        "label": "iteration",
                        "scale": "linear"
                    },
                    "ObjectiveAxis": {
                        "objectivesToPlot": [
                            "Y1",
                            "Y2",
                            "Y3",
                            "Y4",
                            "Y5"
                        ],
                        "normalize": true,
                        "NormalizationStrategy": {
                            "MinOverAll": {
                                "Type": "min_over_all_experiments"
                            }
                        },
                        "label": "Normalised objective",
                        "scale": "linear"
                    }
                }
            }
        },
        "Plot_1": {
            "PlotType": {
                "ConvergencePlot": {
                    "Type": "convergence_plot",
                    "enableGrouping": true,
                    "MetricAxis": {
                        "metricDescription": "iterations completed",
                        "label": "Iteration",
                        "scale": "linear"
                    },
                    "ObjectiveAxis": {
                        "objectivesToPlot": [
                            "Y1",
                            "Y2",
                            "Y3",
                            "Y4",
                            "Y5"
                        ],
                        "normalize": false,
                        "NormalizationStrategy": {
                            "MinOverAll": {
                                "Type": "min_over_all_experiments"
                            }
                        },
                        "label": "Objective value",
                        "scale": "linear"
                    }
                }
            }
        },
        "Plot_2": {
            "PlotType": {
                "ConvergencePlot": {
                    "Type": "convergence_plot",
                    "enableGrouping": true,
                    "MetricAxis": {
                        "metricDescription": "time",
                        "label": "Computation time (s)",
                        "scale": "log10"
                    },
                    "ObjectiveAxis": {
                        "objectivesToPlot": [
                            "Y1",
                            "Y2",
                            "Y3",
                            "Y4",
                            "Y5"
                        ],
                        "normalize": false,
                        "NormalizationStrategy": {
                            "MinOverAll": {
                                "Type": "min_over_all_experiments"
                            }
                        },
                        "label": "Objective value",
                        "scale": "linear"
                    }
                }
            }
        }
    }
}

